# PowerShell 5.1 читает .ps1 без BOM в ANSI и ломается на кириллице,
# поэтому файлы должны оставаться UTF-8 с BOM и CRLF.
* text=auto eol=crlf

*.ps1  text eol=crlf working-tree-encoding=UTF-8
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.md   text eol=lf
*.txt  text eol=crlf
*.html text eol=lf
*.py   text eol=lf

*.ico  binary
*.exe  binary
*.zip  binary
*.png  binary
